# Tunnelblick/OpenVPN as the Claude VPN.
# It must own the route to Anthropic (default route or 160.79.104.0/21).
# If Tunnelblick is only for corporate subnets and Hiddify should keep Claude,
# use VPN_PROCESS="HiddifyPacketTunnel" instead and keep Tunnelblick split.
VPN_MODE=tun
VPN_NAME="Tunnelblick"
VPN_PROCESS="Tunnelblick"
VPN_PROXY_URL="http://127.0.0.1:12334"
VPN_EXPECTED_EXIT_IP=""
ANTHROPIC_IP="160.79.104.10"
ANTHROPIC_PROBE_URL="https://api.anthropic.com/"
ANTHROPIC4_CIDR="160.79.104.0/21"
ANTHROPIC6_CIDR="2607:6bc0::/32"
PHYSICAL_IFACES="en0 en1 en2 en3 en4 bridge0"
BLOCK_SENTRY=1
SENTRY_HOSTS="o1158394.ingest.us.sentry.io"
