# Copy to config.env and edit.  install.sh / verify.sh / diagnostics/collect.sh
# read config.env from the project directory automatically.  config.env is
# gitignored so per-machine paths and proxy ports do not land in git.

# auto | tun | proxy
#   auto  = prefer TUN if Anthropic is routed via utun* and the optional
#           process check passes; otherwise use the proxy probe.
#   tun   = require Anthropic to be routed via utun* (Hiddify TUN,
#           WireGuard, OpenVPN/Tunnelblick, Streisand, ...).
#   proxy = require a local HTTP proxy (Hiddify mixed proxy, another client's
#           local proxy, etc.).
VPN_MODE=auto

# Human-readable name used in logs and verify output.
VPN_NAME="Hiddify"

# Optional: require this process to be alive (pgrep -f).  Empty = no check.
# Examples: HiddifyPacketTunnel, Tunnelblick, openvpn, wireguard-go, wg-quick
VPN_PROCESS="HiddifyPacketTunnel"

# Proxy mode: local HTTP proxy URL.  SOCKS-only clients need an HTTP front.
VPN_PROXY_URL="http://127.0.0.1:12334"

# Optional: expected exit IP for verify.sh (empty = skip).  Useful to prove
# that the request really left through the chosen VPN and not another one.
VPN_EXPECTED_EXIT_IP=""

# Anthropic ranges (one CIDR each; edit the files after install if you need more).
ANTHROPIC_IP="160.79.104.10"
ANTHROPIC_PROBE_URL="https://api.anthropic.com/"
ANTHROPIC4_CIDR="160.79.104.0/21"
ANTHROPIC6_CIDR="2607:6bc0::/32"

# Physical interfaces to block.  The installer filters this list to existing
# interfaces.  Add Ethernet/USB adapters if you use them.
PHYSICAL_IFACES="en0 en1 en2 en3 en4 bridge0"

# Claude Desktop Sentry DSN hosts to sinkhole in /etc/hosts.  Set to 0 to skip.
BLOCK_SENTRY=1
SENTRY_HOSTS="o1158394.ingest.us.sentry.io"
